# Construct the minimum command-capable ship, active crew, and carried terrain vehicle state.
WAIT 1200
WRITE_RAM8 FF943D 01
WRITE_RAM8 FF943E 01
WRITE_RAM8 FF943F 20
WRITE_RAM16 FF9572 00C8
WRITE_RAM8 FF97D3 01
WRITE_RAM8 FF9835 01
WRITE_RAM8 FFB84D CB
WRITE_RAM8 FFB855 64
WRITE_RAM8 FFB856 64
WRITE_RAM32 FFB8E2 00015F7E
WRITE_RAM8 FFC2A9 01
WRITE_RAM16 FF82EC 0001
WRITE_RAM16 FF95B8 005A
WRITE_CPU_A7 FFF000
RESTART_GAME 016BAE
WAIT 600
ASSERT_RAM8 FFC2A9 02
PRESS C 2
WAIT 120
PRESS DOWN 2
WAIT 60
PRESS A 2
WAIT 120
# Select a planet record instead of Starport before choosing LAND.
WRITE_RAM16 FFA6A8 0015
PRESS A 2
WAIT 30
ASSERT_RAM16 FFB84C 07BC
PRESS DOWN 300
WAIT 300
PRESS A 2
WAIT 268
ASSERT_RAM8 FFC2A9 04
ASSERT_RAM8 FF97D3 01
ASSERT_RAM8 FF9835 01
ASSERT_RAM16 FF9572 00C8
# Let surface initialization finish, then select the initial DISEMBARK item.
WAIT 600
ASSERT_RAM16 FF93AC 0001
PRESS C 2
WAIT 120
PRESS A 2
WAIT 120
ASSERT_RAM8 FFC2A9 04
ASSERT_RAM16 FF93AC 0002
ASSERT_RAM16 FF85B8 4A02
ASSERT_RAM16 FF85BA 3E02
# The terrain vehicle starts under the ship; select EMBARK from surface options.
PRESS C 2
WAIT 120
PRESS DOWN 2
WAIT 40
PRESS DOWN 2
WAIT 40
PRESS DOWN 2
WAIT 40
PRESS DOWN 2
WAIT 40
PRESS A 2
WAIT 120
ASSERT_RAM8 FFC2A9 04
ASSERT_RAM16 FF93AC 0001
ASSERT_RAM16 FF85B8 47FE
ASSERT_RAM16 FF85BA 3BFE
# Hold A through lift-off, then verify the stable orbit checkpoint.
PRESS A 600
WAIT 2400
ASSERT_RAM8 FFC2A9 02
ASSERT_RAM8 FF97D3 01
ASSERT_RAM8 FF9835 01
ASSERT_RAM16 FF9572 00C6
ASSERT_RAM16 FFB84C 07BC
ASSERT_RAM16 FFA562 0001
ASSERT_RAM8 FF938E 18
ASSERT_RAM16 FF93AC 0000
ASSERT_RAM16 FF93B4 C886
EXIT 0
