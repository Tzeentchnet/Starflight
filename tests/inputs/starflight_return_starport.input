# Construct the minimum observed command-capable ship state after normal boot.
WAIT 1200
WRITE_RAM8 FF943D 01
WRITE_RAM8 FF943E 01
WRITE_RAM8 FF943F 20
WRITE_RAM16 FF9572 00C8
WRITE_RAM8 FFB84D CB
WRITE_RAM8 FFB855 64
WRITE_RAM8 FFB856 64
WRITE_RAM32 FFB8E2 00015F7E
WRITE_RAM8 FFC2A9 01
WRITE_RAM16 FF82EC 0001
WRITE_RAM16 FF95B8 005A
WRITE_CPU_A7 FFF000
RESTART_GAME 016BAE
WAIT 600
ASSERT_RAM8 FFC2A9 02
ASSERT_RAM16 FFB8E2 0001
ASSERT_RAM16 FFB8E4 5F7E
PRESS C 2
WAIT 120
PRESS DOWN 2
WAIT 60
PRESS A 2
WAIT 120
PRESS A 2
WAIT 600
ASSERT_RAM8 FFC2A9 01
ASSERT_RAM16 FFB8E2 0001
ASSERT_RAM16 FFB8E4 5F7E
EXIT 0
