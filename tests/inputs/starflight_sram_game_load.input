# Load GAME 1, verify symbolic ship/crew fields, then launch to orbit.
WAIT 1200
PRESS A 2
WAIT 30
PRESS DOWN 2
WAIT 10
PRESS A 2
WAIT 180
ASSERT_RAM16 FFC2A0 5445
ASSERT_RAM16 FFC2A2 5354
ASSERT_RAM16 FF97F7 4352
ASSERT_RAM16 FF97F9 4557
WRITE_RAM8 FFC2A9 01
WRITE_RAM16 FF82EC 0001
WRITE_RAM16 FF95B8 005A
WRITE_CPU_A7 FFF000
RESTART_GAME 016BAE
WAIT 600
ASSERT_RAM8 FFC2A9 02
ASSERT_RAM16 FFC2A0 5445
ASSERT_RAM16 FF97F7 4352
WAIT 1
